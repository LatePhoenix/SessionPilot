<Window x:Class="SessionPilot.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SessionPilot"
        Height="760"
        Width="1180"
        MinHeight="560"
        MinWidth="880"
        Background="#0F1722"
        Foreground="#EAF1F8"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#161F2D" BorderBrush="#2C3A4D" BorderThickness="0,0,1,0" Padding="8,16,8,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="SESSIONPILOT" FontSize="14" FontWeight="SemiBold" Margin="12,0,12,4"/>
                    <TextBlock Text="Unprivileged" Foreground="#9FB0C3" Margin="12,0,12,16" FontSize="12"/>
                </StackPanel>
                <TextBlock DockPanel.Dock="Bottom" Text="Live Process Lasso writes are disabled." Foreground="#9FB0C3" TextWrapping="Wrap" Margin="12,16,12,0" FontSize="12"/>
                <StackPanel>
                    <Button x:Name="NavDashboard" Content="Dashboard" Style="{StaticResource NavButton}" Click="ShowDashboard"/>
                    <Button x:Name="NavDiagnostics" Content="Diagnostics" Style="{StaticResource NavButton}" Click="ShowDiagnostics"/>
                    <Button x:Name="NavLoadouts" Content="Loadouts" Style="{StaticResource NavButton}" Click="ShowLoadouts"/>
                    <Button x:Name="NavPrompt" Content="Prompt" Style="{StaticResource NavButton}" Click="ShowPrompt"/>
                    <Button x:Name="NavPlan" Content="Plan review" Style="{StaticResource NavButton}" Click="ShowPlan"/>
                    <Button x:Name="NavSession" Content="Session" Style="{StaticResource NavButton}" Click="ShowSession"/>
                    <Button x:Name="NavMeasurement" Content="Measurement" Style="{StaticResource NavButton}" Click="ShowMeasurement"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <DockPanel Grid.Column="1" Margin="20,16,20,16">
            <TextBlock x:Name="PageTitle" DockPanel.Dock="Top" Text="Dashboard" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,12"/>
            <Border DockPanel.Dock="Top" Background="#161F2D" BorderBrush="#2C3A4D" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,12">
                <UniformGrid Columns="5">
                    <StackPanel Margin="4">
                        <TextBlock Text="COMPILED" Foreground="#9FB0C3" FontSize="11"/>
                        <TextBlock x:Name="StatusCompiled" Text="not compiled" FontFamily="Cascadia Mono, Consolas"/>
                    </StackPanel>
                    <StackPanel Margin="4">
                        <TextBlock Text="PERSISTED" Foreground="#9FB0C3" FontSize="11"/>
                        <TextBlock x:Name="StatusPersisted" Text="not-written" FontFamily="Cascadia Mono, Consolas"/>
                    </StackPanel>
                    <StackPanel Margin="4">
                        <TextBlock Text="GOVERNOR" Foreground="#9FB0C3" FontSize="11"/>
                        <TextBlock x:Name="StatusGovernor" Text="not-verified" FontFamily="Cascadia Mono, Consolas"/>
                    </StackPanel>
                    <StackPanel Margin="4">
                        <TextBlock Text="EFFECTIVE" Foreground="#9FB0C3" FontSize="11"/>
                        <TextBlock x:Name="StatusEffective" Text="not-observed" FontFamily="Cascadia Mono, Consolas"/>
                    </StackPanel>
                    <StackPanel Margin="4">
                        <TextBlock Text="PERFORMANCE" Foreground="#9FB0C3" FontSize="11"/>
                        <TextBlock x:Name="StatusPerformance" Text="not-measured" FontFamily="Cascadia Mono, Consolas"/>
                    </StackPanel>
                </UniformGrid>
            </Border>

            <Grid>
                <ScrollViewer x:Name="PageDashboard" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock x:Name="DashboardBody" TextWrapping="Wrap" LineHeight="20"/>
                        <TextBlock Text="Guided workflows" FontWeight="SemiBold" Margin="0,16,0,8"/>
                        <TextBlock x:Name="GuidedBody" TextWrapping="Wrap" Foreground="#9FB0C3"/>
                        <TextBlock Text="Power owner" FontWeight="SemiBold" Margin="0,16,0,8"/>
                        <TextBlock x:Name="PowerPlans" TextWrapping="Wrap" Foreground="#9FB0C3"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="Record Process Lasso" Style="{StaticResource PrimaryButton}" Click="RecordProcessLassoPower"/>
                            <Button Content="Record Windows" Margin="8,0,0,0" Style="{StaticResource PrimaryButton}" Click="RecordWindowsPower"/>
                        </StackPanel>
                        <TextBlock x:Name="PowerDecisionText" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        <TextBlock Text="Triggers" FontWeight="SemiBold" Margin="0,16,0,8"/>
                        <CheckBox x:Name="TriggersOptIn" Content="Opt in to suggestions. This does not apply a plan or request elevation." Foreground="#EAF1F8"/>
                        <TextBlock Text="Signaled loadout ids, one per line" Foreground="#9FB0C3" Margin="0,8,0,4"/>
                        <TextBox x:Name="TriggerSignals" AcceptsReturn="True" Height="72"/>
                        <Button Content="Suggest" HorizontalAlignment="Left" Margin="0,8,0,0" Style="{StaticResource PrimaryButton}" Click="SuggestTrigger"/>
                        <TextBlock x:Name="TriggerSuggestion" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </ScrollViewer>

                <DockPanel x:Name="PageDiagnostics" Visibility="Collapsed">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock x:Name="DiagnosticsMeta" Foreground="#9FB0C3" TextWrapping="Wrap"/>
                        <TextBlock Text="GPU engine counters are unavailable. Working set is not memory pressure. High CPU does not authorize a close." Foreground="#9FB0C3" TextWrapping="Wrap" Margin="0,4,0,8"/>
                        <StackPanel Orientation="Horizontal">
                            <CheckBox x:Name="ApproveClose" Content="This one selected app is optional and I approve a graceful close" Foreground="#EAF1F8" VerticalAlignment="Center" Checked="HoldCloseTarget" Unchecked="ReleaseCloseTarget"/>
                            <Button Content="Request close" Margin="12,0,0,0" Style="{StaticResource PrimaryButton}" Click="RequestClose"/>
                        </StackPanel>
                        <TextBlock x:Name="CloseResult" TextWrapping="Wrap" Margin="0,8,0,8" Foreground="#9FB0C3"/>
                    </StackPanel>
                    <ListView x:Name="ProcessList">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Name" DisplayMemberBinding="{Binding Name}" Width="160"/>
                                <GridViewColumn Header="PID" DisplayMemberBinding="{Binding Pid}" Width="70"/>
                                <GridViewColumn Header="Created" DisplayMemberBinding="{Binding Created}" Width="180"/>
                                <GridViewColumn Header="Access" DisplayMemberBinding="{Binding Access}" Width="110"/>
                                <GridViewColumn Header="CPU" DisplayMemberBinding="{Binding Cpu}" Width="220"/>
                                <GridViewColumn Header="Working set" DisplayMemberBinding="{Binding WorkingSet}" Width="140"/>
                                <GridViewColumn Header="Class" DisplayMemberBinding="{Binding Classification}" Width="160"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>

                <DockPanel x:Name="PageLoadouts" Visibility="Collapsed">
                    <ListBox x:Name="LoadoutList" DockPanel.Dock="Left" Width="280" Margin="0,0,12,0" SelectionChanged="LoadoutSelected"/>
                    <TextBlock x:Name="LoadoutDetail" TextWrapping="Wrap" LineHeight="20"/>
                </DockPanel>

                <DockPanel x:Name="PagePrompt" Visibility="Collapsed">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Interpret" Style="{StaticResource PrimaryButton}" Click="InterpretPrompt"/>
                        <TextBox x:Name="OllamaModel" Width="220" Margin="8,0,0,0" ToolTip="Installed model name"/>
                        <Button Content="Interpret with Ollama" Margin="8,0,0,0" Style="{StaticResource PrimaryButton}" Click="InterpretWithOllama"/>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Bottom" x:Name="PromptResult" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    <TextBox x:Name="PromptBox" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                </DockPanel>

                <DockPanel x:Name="PagePlan" Visibility="Collapsed">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <CheckBox x:Name="ApprovePlan" Content="I approve this dry-run plan for one isolated copy" Foreground="#EAF1F8" Checked="ApproveCurrentPlan" Unchecked="ClearPlanApproval"/>
                        <TextBlock Text="Isolated copy path. A live Process Lasso candidate is refused. No elevated helper is used." Foreground="#9FB0C3" TextWrapping="Wrap" Margin="0,8,0,4"/>
                        <TextBox x:Name="IsolatedPath"/>
                        <Button Content="Apply to isolated copy" HorizontalAlignment="Left" Margin="0,8,0,0" Style="{StaticResource PrimaryButton}" Click="ApplyIsolated"/>
                        <TextBlock x:Name="ApplyResult" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                    <ListBox x:Name="PlanChanges"/>
                </DockPanel>

                <DockPanel x:Name="PageSession" Visibility="Collapsed">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock x:Name="SessionPhaseText" Text="Idle" FontFamily="Cascadia Mono, Consolas" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Button Content="Begin" Style="{StaticResource PrimaryButton}" Click="BeginSession"/>
                            <Button Content="Continue" Margin="8,0,0,0" Style="{StaticResource PrimaryButton}" Click="ContinueSession"/>
                        </StackPanel>
                        <TextBlock Text="Confirmed path or URI" Foreground="#9FB0C3"/>
                        <TextBox x:Name="LaunchPath" Margin="0,4,0,8"/>
                        <CheckBox x:Name="PathConfirmed" Content="I confirmed this path or URI" Foreground="#EAF1F8"/>
                        <CheckBox x:Name="AlreadyRunning" Content="Already running; do not take ownership" Foreground="#EAF1F8" Margin="0,8,0,8"/>
                        <TextBlock Text="Approved arguments, one per line. Prompt text is not used." Foreground="#9FB0C3"/>
                        <TextBox x:Name="LaunchArguments" AcceptsReturn="True" Height="80" Margin="0,4,0,8"/>
                        <Button Content="Launch" HorizontalAlignment="Left" Style="{StaticResource PrimaryButton}" Click="LaunchConfirmed"/>
                        <TextBlock x:Name="LaunchResultText" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </DockPanel>

                <DockPanel x:Name="PageMeasurement" Visibility="Collapsed">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="Performance effect stays not-measured until a real import exists." Foreground="#9FB0C3" TextWrapping="Wrap"/>
                        <TextBlock Text="Label" Foreground="#9FB0C3" Margin="0,8,0,4"/>
                        <TextBox x:Name="MeasurementLabel"/>
                        <TextBlock Text="Confounders" Foreground="#9FB0C3" Margin="0,8,0,4"/>
                        <TextBox x:Name="MeasurementConfounders" AcceptsReturn="True" Height="72"/>
                        <Button Content="Record run" HorizontalAlignment="Left" Margin="0,8,0,8" Style="{StaticResource PrimaryButton}" Click="RecordMeasurement"/>
                    </StackPanel>
                    <ListBox x:Name="MeasurementList"/>
                </DockPanel>
            </Grid>
        </DockPanel>
    </Grid>
</Window>
