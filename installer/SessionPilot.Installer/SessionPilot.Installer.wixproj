<Project Sdk="WixToolset.Sdk/6.0.2">

  <PropertyGroup>
    <OutputName>SessionPilot</OutputName>
    <InstallerPlatform>x64</InstallerPlatform>
    <Cultures>en-US</Cultures>
    <OutputPath>$(MSBuildThisFileDirectory)..\..\artifacts\installer\</OutputPath>
    <!-- Harvested per-user files cannot each take an HKCU key path. WiX documents these ICE results for that case. -->
    <SuppressIces>ICE38;ICE64;ICE91</SuppressIces>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="6.0.2" />
  </ItemGroup>

  <Target Name="PublishSessionPilot" BeforeTargets="BeforeBuild">
    <PropertyGroup>
      <_AppProject>$(MSBuildThisFileDirectory)..\..\src\SessionPilot.App\SessionPilot.App.csproj</_AppProject>
      <_PublishDir>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\artifacts\publish\win-x64'))</_PublishDir>
    </PropertyGroup>
    <MSBuild
      Projects="$(_AppProject)"
      Targets="Restore;Publish"
      Properties="Configuration=Release;RuntimeIdentifier=win-x64;SelfContained=true;PublishDir=$(_PublishDir)/;DebugType=none;DebugSymbols=false" />
    <Error
      Condition="!Exists('$(_PublishDir)\SessionPilot.App.exe')"
      Text="Self-contained publish did not produce SessionPilot.App.exe." />
  </Target>

  <Target Name="RemoveLooseCabinet" AfterTargets="Build">
    <Delete Files="$(OutputPath)cab1.cab" />
  </Target>

</Project>
